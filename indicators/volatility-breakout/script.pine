//@version=6
// Φ_SEED DECOMPOSITION
// - CORE OBJECTIVE: Identify volatility breakouts using Keltner Channels.
// - TIME HORIZON: Intraday / Swing.
// - HARD INVARIANTS: v6 only, No repaint, Explicit types, AX/PX safety.
// - KEY VARIABLES: Basis (EMA), Width (ATR * Multiplier).
// - AMBIGUITY FLAGS: No volume filter by default.

indicator("Master-Edition Volatility Breakout", overlay=true, timeframe="", timeframe_gaps=true)

// --- INPUTS ---
int basisLen   = input.int(20, "Basis Length (EMA)", minval=1)
float mult     = input.float(2.0, "ATR Multiplier", minval=0.1, step=0.1)
int atrLen     = input.int(20, "ATR Length", minval=1)
float src = input.source(close, "Source")

// --- CALCULATIONS (RHO Protective Bias) ---
// Explicit types and nz() guarding
float basis = ta.ema(src, basisLen)
float atr   = ta.atr(atrLen)
float upper = basis + (mult * atr)
float lower = basis - (mult * atr)

// --- SIGNAL LOGIC ---
// Bullish Breakout: Close crosses above upper channel
bool bullBreak = ta.crossover(close, upper)
// Bearish Breakout: Close crosses below lower channel
bool bearBreak = ta.crossunder(close, lower)

// --- PLOTTING ---
plot(basis, "Basis (EMA)", color=color.gray, linewidth=1, style=plot.style_line)
p_upper = plot(upper, "Upper Channel", color=color.new(color.blue, 0), linewidth=1)
p_lower = plot(lower, "Lower Channel", color=color.new(color.blue, 0), linewidth=1)
fill(p_upper, p_lower, color=color.new(color.blue, 90), title="Channel Fill")

plotshape(bullBreak, style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small, title="Bullish Breakout")
plotshape(bearBreak, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.small, title="Bearish Breakout")

// --- ALERTS ---
if bullBreak
    alert("Bullish Volatility Breakout on " + syminfo.ticker, alert.freq_once_per_bar)
if bearBreak
    alert("Bearish Volatility Breakout on " + syminfo.ticker, alert.freq_once_per_bar)
